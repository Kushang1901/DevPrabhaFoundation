# ==============================================================================
# Dev Prabha Foundation - Environment Variables Template
# ==============================================================================
# IMPORTANT FOR HOSTING:
# Do NOT commit or share real secrets inside source code.
# Configure these variables directly in your hosting dashboard (Vercel / VPS / cPanel).

# 1. MongoDB Connection String (Keep private to the Trust's MongoDB Atlas account)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devprabha?retryWrites=true&w=majority
MONGODB_DB=devprabha

# 2. Official Trust Merchant UPI ID (e.g., your-merchant-id@pnb)
# Used by /api/qr and /api/pay for dynamic QR generation
DPF_UPI_ID=your-trust-merchant-vpa@pnb
DPF_ACCOUNT_NAME=DEV PRABHA FOUNDATION

# 3. Canonical Production Domain (used for SEO, Sitemap, Robots, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://dpf.org.in
